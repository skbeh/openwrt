+    fn validate_sni_config(tls_config: &TlsConfig) -> Result<()> {
+        if let Some(sni_config) = &tls_config.sni {
+            #[cfg(feature = "native-tls")]
+            if sni_config.enabled && sni_config.server_name.is_some() {
+                bail!("server_name is not supported with native-tls transport. Use rustls feature or remove server_name");
+            }
+
+            if !sni_config.enabled {
+                if sni_config.server_name.is_some() {
+                    bail!("SNI is disabled but server_name is set");
+                }
+            }
+        }
+        Ok(())
+    }
